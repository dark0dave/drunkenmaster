IF
  CheckStatGT(Player1,50,31)
  Kit(Player1,%kit_id%)
  Global("ZD_DRUNK","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("ZD_DRUNK","GLOBAL",1)
END

IF
  CheckStatLT(Player1,50,31)
  Kit(Player1,%kit_id%)
  Global("ZD_DRUNK","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("ZD_DRUNK","GLOBAL",0)
END

