// Wine
ACTION_IF NOT FILE_EXISTS_IN_GAME ~zdwine1.itm~ BEGIN
  COPY ~%MOD_FOLDER%/itm/zdwine.itm~ ~override/zdwine1.itm~
    SAY NAME1 ~Wine~
    SAY NAME2 ~Winter Wine~
    SAY UNIDENTIFIED_DESC ~Looks to be some kind of wine.

STATISTICS:

Weight: 1~
    SAY DESC ~The label on this wine bottle reads "Winter Wine" and claims to be a fruity blend of spices and dew-flower fragrances. The vineyards of Marsember are well-known for their firm grapes, which draw their flavor from the fragrant salt air of the Sea of Fallen Stars.

STATISTICS:

Weight: 1~
    WRITE_ASCII 0x3a zdiwine1 // Inventory Icon
    WRITE_ASCII 0x58 zddwine1 // Description Icon
    WRITE_LONG  0x34 15       // Price
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~zdiwine1.bam~ BEGIN
  COPY ~%MOD_FOLDER%/bam/zdiwine1.bam~ ~override~
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~zddwine1.bam~ BEGIN
  COPY ~%MOD_FOLDER%/bam/zddwine1.bam~ ~override~
END

ACTION_IF (GAME_IS ~tob bgt bg2ee eet~) BEGIN
  // Rassmusen Mead  7
  // Dark Island Stout  3
  // Dragon's Beer  1
  // Elminster's Beer  1
  // Winter Wine  15
  // Westgate Wine  8
  // Evermead  30
  ACTION_IF FILE_EXISTS_IN_GAME ~ppstor01.sto~ BEGIN  // Innkeeper (Vulgar Monkey)
    COPY_EXISTING ~ppinn01.sto~ ~override~
      LPF ADD_STORE_ITEM_EX
        INT_VAR
          stack = 3
        STR_VAR
          item_name = ~zdwine1~ // Winter Wine
      END
    BUT_ONLY
  END
